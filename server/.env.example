# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model slug from https://openrouter.ai/models. This default is a solid,
# capable choice -- swap it for whatever fits your budget/quality needs.
# NOTE: OpenRouter's catalog changes over time; if this 404s with "No
# endpoints found", check https://openrouter.ai/models for the current slug.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Max tokens per generation. Keep this bounded -- OpenRouter reserves the
# cost of the model's full max output upfront if you omit it, which can
# fail with a 402 even on an account that has enough credits for a normal
# response.
OPENROUTER_MAX_TOKENS=2000

# Shared secret the Android app sends as "Authorization: Bearer <this>".
# This is NOT the OpenRouter key -- it just stops random people from hitting
# your endpoint and spending your OpenRouter credits. Generate one with:
#   openssl rand -hex 32
APP_SHARED_SECRET=change-me-to-a-random-string

# Optional, sent to OpenRouter for their leaderboard/attribution.
OPENROUTER_SITE_URL=https://github.com/provarkai/Naija-trivial-
OPENROUTER_SITE_NAME=Business Edge AI

# Server-side purchase verification (Google Play Developer API). Without
# this, /api/verify-purchase always fails and the app falls back to
# trusting the client-side purchase check -- see docs/PLAY_STORE_RELEASE.md
# "Server-side purchase verification" for how to create this service
# account in Google Cloud + grant it access in Play Console.
#
# Paste the *entire* service account JSON key file, base64-encoded on one
# line: base64 -w0 service-account-key.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Must match app/build.gradle.kts's applicationId.
ANDROID_PACKAGE_NAME=com.ai4biz.app
