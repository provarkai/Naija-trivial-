; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited
; using the UI and not by hand.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Naija Trivia Blitz"
config/description="A Nigerian-themed mobile trivia game — Naija Music, Nollywood, History, Sports, General Knowledge, and Pidgin & Proverbs."
run/main_scene="res://scenes/Home.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.043137, 0.180392, 0.109804, 1)
config/icon="res://icon.svg"

[autoload]

GameStateManager="*res://scripts/autoload/GameStateManager.gd"
QuestionBank="*res://scripts/autoload/QuestionBank.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
