# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System / editor cruft
.DS_Store
Thumbs.db

# Android build output / keystores (never commit signing keys)
android/
*.apk
*.aab
*.keystore
*.jks

# Unreviewed AI-drafted question batches (tools/generate_questions.py) —
# working files for the review step, never committed directly; approved
# questions get merged into data/questions/<category>.json instead.
data/questions/drafts/
