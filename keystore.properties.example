# Copy to keystore.properties (gitignored, never committed) once you have
# your own release upload key. Without this file, release builds are
# unsigned and can't be uploaded to Play Console.
#
# Generate a key:
#   keytool -genkeypair -v -keystore keystore/ai4biz-release.jks -alias ai4biz \
#     -keyalg RSA -keysize 2048 -validity 10000
# (PKCS12 keystores require storePassword == keyPassword; keytool enforces
# this automatically.)

storeFile=keystore/ai4biz-release.jks
storePassword=changeme
keyAlias=ai4biz
keyPassword=changeme
